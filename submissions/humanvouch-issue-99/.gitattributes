# Normalize source files to LF on checkout across operating systems.
* text=auto
*.sh text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.vue text eol=lf
*.circom text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.rs text eol=lf
*.md text eol=lf

# ZK proving artifacts and demo video must never be text-converted.
*.mp4 binary
*.zkey binary
*.wasm binary
